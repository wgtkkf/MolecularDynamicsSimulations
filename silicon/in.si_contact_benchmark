# =====================================================================
#  BENCHMARK / VALIDATION script for the Si-Si gap conductance study
#
#  Run as:   lmp -in in.si_contact_benchmark -var mode 0
#
#    mode 0 : CONTINUOUS PERFECT CRYSTAL  (null test)
#             one SW over all atoms, zero separation, no interface.
#             Expected result: a single straight T(z) with NO jump at
#             the nominal interface plane.  If your fitting routine
#             extracts a nonzero Delta_T here, the bias is in your
#             ANALYSIS and it contaminates every gap result too.
#             Secondary output: the length-limited thermal conductivity
#             of SW Si, which you can check against the literature.
#
#    mode 1 : VAN DER WAALS CONTACT
#             two slabs, no covalent bond across the interface, held at
#             the separation d_contact found by mode 2.  This is the
#             finite-G benchmark; expect O(1e8) W/m^2 K.
#
#    mode 2 : SEPARATION ENERGY SCAN
#             finds d_contact.  Run this FIRST, look at scan.dat, and
#             put the minimum-energy separation into v_dcontact below.
#
#  Everything else (geometry, baths, analysis) is identical across the
#  three modes, which is the whole point -- only the interface changes.
# =====================================================================

variable mode    index 0

units           metal
atom_style      atomic
boundary        p p f
atom_modify     map array

# ------------------------------------------------------------ geometry
variable a        equal 5.431
variable nx       equal 6
variable ny       equal 6
variable nz       equal 24

# <<< fill this in from the mode-2 scan before running mode 1
variable dcontact equal 4.3

variable Lx      equal v_nx*v_a
variable Ly      equal v_ny*v_a
variable Ls      equal v_nz*v_a

# mode 0 keeps the crystal continuous: zero extra separation
if "${mode} == 0" then &
  "variable shift equal 0.0" &
else &
  "variable shift equal v_dcontact-0.25*v_a"

# the scan starts well inside the repulsive wall and walks outward
if "${mode} == 2" then "variable shift equal 2.5-0.25*v_a"

variable ztop    equal 2*v_Ls+v_shift+15.0

lattice         diamond ${a}
region          box block 0 ${Lx} 0 ${Ly} -8.0 ${ztop} units box
create_box      2 box

region          rall block INF INF INF INF 0.0 $(2*v_Ls-0.01) units box
create_atoms    1 region rall

region          rup block INF INF INF INF $(v_Ls-0.01) INF units box
group           upper region rup
group           lower subtract all upper
set             group upper type 2
displace_atoms  upper move 0.0 0.0 ${shift} units box

mass            1 28.0855
mass            2 28.0855

# ----------------------------------------------------------- potential
# mode 0: ONE SW instance covering both types -> the two "slabs" are
#         covalently bonded into a single perfect crystal.  Types 1 and
#         2 are retained only so the binning and grouping commands stay
#         byte-for-byte identical to the other modes.
if "${mode} == 0" then &
  "pair_style sw" &
  "pair_coeff * * Si.sw Si Si" &
else &
  "pair_style hybrid/overlay sw sw lj/cut 15.0" &
  "pair_coeff * * sw 1 Si.sw Si NULL" &
  "pair_coeff * * sw 2 Si.sw NULL Si" &
  "pair_coeff 1 2 lj/cut 0.01743 3.826"

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# -------------------------------------------------------------- groups
variable Ltot   equal 2*v_Ls+v_shift
variable z1     equal 2*v_a
variable z2     equal 6*v_a
variable z3     equal v_Ltot-6*v_a
variable z4     equal v_Ltot-2*v_a

region          rwb  block INF INF INF INF INF  ${z1} units box
region          rhot block INF INF INF INF ${z1} ${z2} units box
region          rcol block INF INF INF INF ${z3} ${z4} units box
region          rwt  block INF INF INF INF ${z4} INF  units box

group           wallb region rwb
group           wallt region rwt
group           walls union wallb wallt
group           mobile subtract all walls
group           hot   region rhot
group           cold  region rcol

velocity        walls set 0.0 0.0 0.0
fix             fwb wallb setforce 0.0 0.0 0.0
fix             fwt wallt setforce 0.0 0.0 0.0

thermo          2000
thermo_style    custom step temp pe etotal
timestep        0.0005

# ===================================================== MODE 2: the scan
if "${mode} != 2" then "jump SELF nemd"

print           "# d[Ang]  PE[eV]" file scan.dat

variable        i loop 41
label           scanloop
  variable      dcur equal 2.5+0.1*(v_i-1)
  min_style     cg
  minimize      1.0e-10 1.0e-12 10000 100000
  variable      epot equal pe
  print         "${dcur} ${epot}" append scan.dat
  displace_atoms upper move 0.0 0.0 0.1 units box
  next          i
jump            SELF scanloop

print           "scan complete -- plot scan.dat, take the minimum, and"
print           "set variable dcontact to that value before running mode 1"
quit

# ====================================================== MODES 0 AND 1
label           nemd

min_style       cg
minimize        1.0e-8 1.0e-10 20000 200000

velocity        mobile create 302.5 4928459 mom yes rot no dist gaussian
fix             eq mobile nvt temp 302.5 302.5 0.1
run             200000                      # 100 ps
unfix           eq
reset_timestep  0

fix             int  mobile nve
fix             hotL hot  langevin 305.0 305.0 0.1 12345 tally yes
fix             colL cold langevin 300.0 300.0 0.1 67890 tally yes

thermo_style    custom step temp f_hotL f_colL
run             1000000                     # 500 ps to steady state

unfix           hotL
unfix           colL
reset_timestep  0
fix             hotL hot  langevin 305.0 305.0 0.1 12345 tally yes
fix             colL cold langevin 300.0 300.0 0.1 67890 tally yes

variable        Eh equal f_hotL
variable        Ec equal f_colL
fix             eout all ave/time 1000 1 1000 v_Eh v_Ec &
                file thermostat_energy_mode${mode}.dat

compute         cch mobile chunk/atom bin/1d z lower $(0.5*v_a) units box
fix             tprof mobile ave/chunk 200 20000 4000000 cch temp &
                file temp_profile_mode${mode}.dat

run             4000000                     # 2 ns

# =====================================================================
#  HOW TO READ THE BENCHMARK
#
#  mode 0 - Plot T(z).  It must be ONE straight line through z = Ls.
#           Now run your interface-fitting script on it anyway: fit the
#           two halves separately and extrapolate.  Whatever Delta_T it
#           returns is your procedure's noise floor.  Any gap result
#           with a Delta_T near that floor is not measurable.
#           Also extract kappa = q'' * L / Delta_T_total and compare to
#           published SW Si values for the same slab length -- this
#           validates the flux units and the thermostat accounting.
#
#  mode 1 - The same analysis now yields a real, finite G.  This is the
#           d -> minimum end point of your G(d) curve, so the gap series
#           must approach it smoothly from above as d decreases.
#
#  A third useful benchmark, if you want a bonded interface with finite
#  G and no free surfaces: keep mode 0's single SW instance but set
#  mass 2 to a heavy fictitious isotope (e.g. 56.17).  That gives a
#  purely mass-mismatched interface with a well-defined analytic
#  expectation from acoustic-mismatch / diffuse-mismatch theory, and it
#  tests the interface machinery without any surface physics at all.
# =====================================================================
