# =====================================================================
#  NEMD calculation of interfacial thermal conductance (Kapitza
#  conductance) between two crystalline Si(001) slabs separated by a
#  vacuum gap of width d.
#
#    Si slab A  |  vacuum gap d  |  Si slab B
#    T_hot = 305 K                 T_cold = 300 K
#
#  Transport direction : z = [001]  (<100> family)
#  Intra-slab bonding  : Stillinger-Weber (two independent instances,
#                        so no covalent bond ever crosses the gap)
#  Inter-slab coupling : Lennard-Jones (vdW / quasi-Casimir channel)
#
#  Set d = 4.30 Ang  -> surfaces at vdW contact (G ~ 1e8 W/m^2K)
#  Set d = 5,6,7,8   -> vacuum-gap series (G falls steeply with d)
#
#  Requires: Si.sw  (ships with LAMMPS in potentials/)
# =====================================================================

# ---------------------------------------------------------------- init
units           metal
atom_style      atomic
boundary        p p f
atom_modify     map array

# ------------------------------------------------------------ geometry
variable a      equal 5.431                 # Si lattice constant [Ang]
variable nx     equal 6                     # cells in x
variable ny     equal 6                     # cells in y
variable nz     equal 24                    # cells per slab along z

# --- surface separation (last atomic plane of A -> first plane of B)
variable d      equal 4.30                  # <<< CHANGE THIS for gap study

# natural (0.25a) interplanar spacing must be subtracted from the shift
variable shift  equal v_d-0.25*v_a
variable Lx     equal v_nx*v_a
variable Ly     equal v_ny*v_a
variable Ls     equal v_nz*v_a              # slab thickness
variable Ltot   equal 2*v_Ls+v_shift
variable ztop   equal v_Ltot+12.0

lattice         diamond ${a}
region          box block 0 ${Lx} 0 ${Ly} -6.0 ${ztop} units box
create_box      2 box

# build one continuous crystal, then split it and pull slab B away
region          rall block INF INF INF INF 0.0 $(2*v_Ls-0.01) units box
create_atoms    1 region rall

region          rup  block INF INF INF INF $(v_Ls-0.01) INF units box
group           upper region rup
group           lower subtract all upper
set             group upper type 2
displace_atoms  upper move 0.0 0.0 ${shift} units box

mass            1 28.0855
mass            2 28.0855

# ----------------------------------------------------------- potential
# Two SW instances: instance 1 acts only on type 1, instance 2 only on
# type 2.  Hence slab A and slab B are each a perfect SW crystal, but
# they are NOT covalently bonded to each other.  The only A-B channel
# is the 1-2 Lennard-Jones term.
pair_style      hybrid/overlay sw sw lj/cut 12.0
pair_coeff      * * sw 1 Si.sw Si NULL
pair_coeff      * * sw 2 Si.sw NULL Si

# UFF-type Si-Si vdW parameters.  eps is THE knob that sets G.
variable eps    equal 0.01743               # [eV]
variable sig    equal 3.826                 # [Ang]
pair_coeff      1 2 lj/cut ${eps} ${sig}

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# -------------------------------------------------------------- groups
variable z1     equal 2*v_a                 # top of bottom fixed wall
variable z2     equal 6*v_a                 # top of hot bath
variable z3     equal v_Ltot-6*v_a          # bottom of cold bath
variable z4     equal v_Ltot-2*v_a          # bottom of top fixed wall

region          rwb  block INF INF INF INF INF  ${z1} units box
region          rhot block INF INF INF INF ${z1} ${z2} units box
region          rcol block INF INF INF INF ${z3} ${z4} units box
region          rwt  block INF INF INF INF ${z4} INF  units box

group           wallb region rwb
group           wallt region rwt
group           walls union wallb wallt
group           mobile subtract all walls
group           hot    region rhot
group           cold   region rcol

# frozen end layers: essential here, otherwise the LJ attraction simply
# pulls the two slabs together and closes the gap
velocity        walls set 0.0 0.0 0.0
fix             fwb wallb setforce 0.0 0.0 0.0
fix             fwt wallt setforce 0.0 0.0 0.0

# ------------------------------------------------------------ relaxation
thermo          1000
thermo_style    custom step temp pe etotal press

min_style       cg
minimize        1.0e-8 1.0e-10 10000 100000

timestep        0.0005                      # 0.5 fs

# ------------------------------------------------- equilibration (NVT)
velocity        mobile create 302.5 4928459 mom yes rot no dist gaussian
fix             eq mobile nvt temp 302.5 302.5 0.1
run             200000                      # 100 ps
unfix           eq
reset_timestep  0

# --------------------------------------------- NEMD: reach steady state
fix             int  mobile nve
fix             hotL hot  langevin 305.0 305.0 0.1 12345 tally yes
fix             colL cold langevin 300.0 300.0 0.1 67890 tally yes

thermo_style    custom step temp f_hotL f_colL
run             1000000                     # 500 ps to reach steady state

# ------------------------------------ production: restart energy tally
unfix           hotL
unfix           colL
reset_timestep  0
fix             hotL hot  langevin 305.0 305.0 0.1 12345 tally yes
fix             colL cold langevin 300.0 300.0 0.1 67890 tally yes

# cumulative thermostat energies [eV] -> slope gives the heat flow
variable        Eh equal f_hotL
variable        Ec equal f_colL
fix             eout all ave/time 1000 1 1000 v_Eh v_Ec &
                file thermostat_energy.dat title3 "# t[ps] E_hot[eV] E_cold[eV]"

# temperature profile, half-unit-cell bins
compute         cch mobile chunk/atom bin/1d z lower $(0.5*v_a) units box
fix             tprof mobile ave/chunk 200 20000 4000000 cch temp &
                file temp_profile.dat

dump            d1 all custom 200000 dump.si id type x y z
run             4000000                     # 2 ns production

# =====================================================================
#  POST-PROCESSING
#
#  1) Heat flow:  fit  E_hot(t)  and  E_cold(t)  vs t (both linear at
#     steady state).  Take  P = 0.5*( |slope_hot| + |slope_cold| )
#     in eV/ps.  Their agreement is your steady-state check.
#
#  2) Flux:  q'' [W/m^2] = P[eV/ps] / A[Ang^2] * 1.602e13
#     with A = Lx*Ly = 32.586 * 32.586 = 1061.8 Ang^2 here.
#
#  3) Delta T: from temp_profile.dat, linear-fit T(z) inside each slab
#     using ONLY the region between the bath and ~1.5 nm from the
#     surface (drop bath bins and the 3-4 bins nearest the gap, which
#     are contaminated by the surface).  Extrapolate both fits to the
#     gap centre and take DT = T_A - T_B.
#
#  4) G = q'' / DT   [W/m^2 K]
# =====================================================================
